# What a profile file looks like. Copy to <name>.toml and set PROFILE=<name>.
# A profile lists one or more [[algorithm]] blocks and nothing else — knob
# values live in algorithms/<type>/params.py, and a params block here is a
# boot error.
#
# Add `allow_live = true` at the top level before any mode = "live" block.

[[algorithm]]
type = "insider_flow"
name = "insider_flow_paper"
mode = "paper"

# A second block runs alongside the first, in its own thread with its own
# ledger. `name` is the DB partition key — keep it stable once set.
#
# copy_trade additionally needs a target set in
# algorithms/copy_trade/params.py (target_address/target_username, or
# watchlist_size > 0); it refuses to boot otherwise.
# [[algorithm]]
# type = "copy_trade"
# name = "copy_trade_paper"
# mode = "paper"
