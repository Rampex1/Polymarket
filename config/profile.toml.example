# Copy to <name>.toml, run with PROFILE=<name>. Blocks only — knob values
# live in algorithms/<type>/params.py, and a params block here is a boot error.

[[algorithm]]
type = "insider_flow"
name = "insider_flow_paper"
mode = "paper"

# Each block gets its own thread and ledger; `name` is the DB partition key.
