# ── Target ───────────────────────────────────────────────────────────────────
TARGET_USERNAME=surfandturf      # username to look up if TARGET_ADDRESS unset
TARGET_ADDRESS=0x...              # target's proxy wallet (from their Polymarket profile URL)

# ── Trading mode ─────────────────────────────────────────────────────────────
PAPER_TRADE=true                  # set to false for live trading
PAPER_STARTING_BALANCE=10000.0    # virtual balance for paper trading
PAPER_FEE_BPS=0                   # simulated fee per side in basis points (e.g. 200 = 2%)

# ── Tiered bet sizing ────────────────────────────────────────────────────────
# Bot looks up target's total position value in a market and bets accordingly:
#   holding < TIER1_MIN                      → skip
#   TIER1_MIN <= holding <= TIER1_MAX        → bet TIER1_SIZE
#   TIER1_MAX <  holding <= TIER2_MAX        → bet TIER2_SIZE
#   TIER2_MAX <  holding                     → bet TIER3_SIZE
TIER1_MIN=80000
TIER1_MAX=150000
TIER1_SIZE=1.0
TIER2_MAX=300000
TIER2_SIZE=2.0
TIER3_SIZE=3.0

# ── Risk limits ──────────────────────────────────────────────────────────────
MIN_ORDER_SIZE_USDC=1.0           # Polymarket protocol minimum is ~$1; skip below
MAX_POSITION_SIZE_USDC=2.0        # max USDC cost per market
MAX_TOTAL_EXPOSURE_USDC=12.0      # max USDC across all open positions
DAILY_LOSS_LIMIT_USDC=4.0         # halt new buys if down this much today
MAX_SLIPPAGE=0.05                 # skip if price moved >5% since signal

# ── Order execution ──────────────────────────────────────────────────────────
ORDER_TYPE=market                 # market (FOK) or limit (GTC)
POLL_INTERVAL_SECONDS=20          # how often to check for new trades

# ── Polymarket credentials (required for live trading) ───────────────────────
POLY_PRIVATE_KEY=0x...            # EOA private key from your wallet
POLY_FUNDER_ADDRESS=0x...         # proxy wallet address (from your Polymarket profile URL)
POLY_API_KEY=...                  # generated by Polymarket API key setup
POLY_API_SECRET=...
POLY_API_PASSPHRASE=...

# ── Notifications + reporting ────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=              # channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
TIMEZONE=America/Los_Angeles      # for daily-summary midnight rollover (e.g. UTC, America/New_York)

# ── Storage ──────────────────────────────────────────────────────────────────
DB_PATH=positions.db
