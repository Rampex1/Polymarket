# ── Target ───────────────────────────────────────────────────────────────────
# surfandturf's proxy-wallet address.
# Find it: visit polymarket.com, open their profile, copy the 0x... from the URL.
TARGET_ADDRESS=0x9f2fe025f84839ca81dd8e0338892605702d2ca8

# ── Execution ────────────────────────────────────────────────────────────────
# true  = log orders without sending (safe default)
# false = live trading
PAPER_TRADE=true

# Fraction of surfandturf's size to copy (0.05 = 5%)
SCALE_FACTOR=0.05

# "market" = Fill-Or-Kill market order (immediate)
# "limit"  = GTC limit order at the signal price (may not fill)
ORDER_TYPE=market

# Minimum order size after scaling (skip if below this)
MIN_ORDER_SIZE_USDC=5.0

# Skip trade if price has moved more than this since the signal (0.05 = 5%)
MAX_SLIPPAGE=0.05

# ── Your Polymarket credentials ───────────────────────────────────────────────
# Your EOA private key (run setup_keys.py once to generate the API keys below)
POLY_PRIVATE_KEY=0x...

# Generated by setup_keys.py
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Your proxy wallet address (same URL trick as TARGET_ADDRESS but for your account)
POLY_FUNDER_ADDRESS=0x...

# ── Notifications ────────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Start a chat with your new bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Risk limits ───────────────────────────────────────────────────────────────
# MAX_POSITION_SIZE_USDC=500
# MAX_TOTAL_EXPOSURE_USDC=2000
# DAILY_LOSS_LIMIT_USDC=200

# ── Optional overrides ────────────────────────────────────────────────────────
# POLL_INTERVAL_SECONDS=20
# MIN_TRADE_SIZE_USDC=50
