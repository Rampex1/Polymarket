# Infrastructure secrets + process-level settings ONLY.
#
# Algorithm behavior (targets, tiers, risk caps, poll cadence, paper
# balances) does NOT live here — it lives in config/<profile>.toml,
# committed to git. Run `python -m bot.params` to see what's configurable
# there, and `python -m bot.params --effective` to see what the current
# PROFILE resolves to.
#
# Per-profile env files: PROFILE=prod loads .env.prod (falls back to .env).
# Keep .env.experimental free of POLY_* creds — that's the guarantee that
# the paper profile can never touch real money.

# ── Polymarket credentials (live trading only; ignored in paper) ─────────────
POLY_PRIVATE_KEY=0x...            # EOA private key from your wallet
POLY_FUNDER_ADDRESS=0x...         # proxy wallet address (from your Polymarket profile URL)
POLY_API_KEY=...                  # generated by Polymarket API key setup
POLY_API_SECRET=...
POLY_API_PASSPHRASE=...
POLY_SIGNATURE_TYPE=3             # 3=new smart-wallet accounts (EIP-1271), 2=legacy Gnosis Safe, 1=email-signup proxy

# ── Notifications + reporting ────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=              # channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
TIMEZONE=America/Los_Angeles      # for daily-summary midnight rollover (e.g. UTC, America/New_York)

# ── Storage ──────────────────────────────────────────────────────────────────
DB_PATH=data/positions.db
