# Secrets ONLY. Everything else lives in committed config:
#   * algorithm behavior  → config/<profile>.toml
#   * Discord webhooks    → config/webhooks.toml (routed by PROFILE)
#
# Per-profile env files: PROFILE=prod loads .env.prod, falling back to
# this .env. Paper profiles never use the POLY_* creds (the CLOB client
# is only built when a profile sets allow_live + mode="live").

# ── Polymarket credentials (live trading only; ignored in paper) ─────────────
POLY_PRIVATE_KEY=0x...            # EOA private key from your wallet
POLY_FUNDER_ADDRESS=0x...         # proxy wallet address (from your Polymarket profile URL)
POLY_API_KEY=...                  # generated by Polymarket API key setup
POLY_API_SECRET=...
POLY_API_PASSPHRASE=...

# ── Discord bot (slash commands: /status /positions /pnl /summary /restart) ──
# Setup: discord.com/developers → New Application → Bot → Reset Token → copy
# OAuth2 invite URL scopes: bot + applications.commands, perms: Send Messages
# DISCORD_BOT_TOKEN=              # required to enable the bot; leave unset to disable
# DISCORD_GUILD_ID=               # server ID (right-click server → Copy ID, needs Developer Mode)
                                  # set this for instant command registration vs 1h global delay

# ── Optional overrides (defaults are right for this deployment) ──────────────
# POLY_SIGNATURE_TYPE=3           # 3=smart-wallet EIP-1271 (default), 2=legacy Gnosis Safe, 1=email-signup proxy
# DISCORD_WEBHOOK_URL=            # beats the webhooks.toml registry — escape hatch only
# TIMEZONE=America/Los_Angeles    # daily-summary rollover (default America/Los_Angeles)
# DB_PATH=data/positions.db       # default data/positions.db
